# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goalfi

# ─── Solana / pm-AMM ───
# devnet | mainnet-beta. Mainnet additionally requires GOALFI_ENABLE_MAINNET=I_UNDERSTAND_THE_RISKS.
GOALFI_CLUSTER=devnet
GOALFI_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_GOALFI_CLUSTER=devnet
NEXT_PUBLIC_GOALFI_RPC_URL=https://api.devnet.solana.com
# Platform market-authority keypair (base58 secret key). Signs initialize_market / resolve_market only.
# Generate with: pnpm --filter @goalfi/chain keygen
GOALFI_MARKET_AUTHORITY_SECRET=

# ─── Auth ───
GOALFI_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=goalfi_session

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=GoalFiBot
# Optional webhook mode for the bot (default: long polling)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
PORT=8080

# ─── Scheduler ───
# Bearer secret for GET /api/cron/tick (hosts without the bot worker, e.g. Vercel Cron)
CRON_SECRET=

# ─── Storage ───
# local | supabase
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence
