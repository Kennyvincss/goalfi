# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goalfi

# ─── Solana / pm-AMM ───
# devnet | mainnet-beta. Mainnet additionally requires GOALFI_ENABLE_MAINNET=I_UNDERSTAND_THE_RISKS.
GOALFI_CLUSTER=devnet
GOALFI_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_GOALFI_CLUSTER=devnet
NEXT_PUBLIC_GOALFI_RPC_URL=https://api.devnet.solana.com
# Platform market-authority keypair (base58 secret key). Signs initialize_market / resolve_market only.
# Generate with: pnpm --filter @goalfi/chain keygen
GOALFI_MARKET_AUTHORITY_SECRET=

# ─── Auth ───
GOALFI_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=goalfi_session

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=GoalFiBot
# Free hosting: run the bot inside the website (webhook) instead of a separate process.
# Requires TELEGRAM_WEBHOOK_SECRET + CRON_SECRET and a scheduler calling /api/cron/tick every minute.
TELEGRAM_RUN_ON_VERCEL=
# Optional self-hosted Telegram Bot API server
TELEGRAM_API_ROOT=
# Optional webhook mode for the standalone bot (default: long polling)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
PORT=8080

# ─── Scheduler ───
# Bearer secret for GET /api/cron/tick (hosts without the bot worker, e.g. Vercel Cron)
CRON_SECRET=

# ─── Storage ───
# local | supabase
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence

# ─── Connected accounts (optional) ───
# 32+ random characters; encrypts provider tokens at rest. Setting it turns on Lichess (no app
# registration needed). Changing it later disconnects everyone.
ACCOUNT_TOKEN_KEY=
# Google Health (Fitbit, Pixel Watch). Redirect URI: <GOALFI_APP_URL>/api/accounts/google/callback
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Withings developer app. Callback URL: <GOALFI_APP_URL>/api/accounts/withings/callback
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Oura API application (scopes: personal, daily, workout). Redirect URI: <GOALFI_APP_URL>/api/accounts/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# GitHub OAuth app. Callback URL: <GOALFI_APP_URL>/api/accounts/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Fair play ───
# Days before a new account can join challenges with a market (default 7). 0 = off (testing only).
TRUST_MIN_ACCOUNT_DAYS=

# Contact address shown on /privacy and /terms.
GOALFI_CONTACT_EMAIL=
